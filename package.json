{
  "name": "datadock",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "DataDock - 轻量级跨平台多数据源管理工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-vue-next": "^1.0.0",
    "monaco-editor": "^0.52.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.1.1"
  }
}
